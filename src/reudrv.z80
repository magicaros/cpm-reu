; =============================================================================
;  reudrv.z80 - resident Z80 part of the C64 CP/M 2.2 REU RAM-disk (drive B:)
;               with Instant REU-Backed Warm Boot (WBOOT Caching)
; =============================================================================
;
;  Assembler : pasmo 0.5.x   (pasmo --public reudrv.z80 reudrv.bin reudrv.sym)
;  Location  : Z80 $FE00-$FFxx  (6510 $0E00-$0Fxx)
;              6510 trampoline sits at Z80 $F980-$F9BF (6510 $0980-$09BF).
;
;  INSTANT REU WARM BOOT (WBOOT CACHING)
;  -------------------------------------
;  Track 0 of Drive B: (REU Bank 0, $0000-$15FF) is reserved (OFF = 1 in DPB)
;  and holds a pristine 5.5 KB ($1600-byte) image of CCP + BDOS captured at
;  install time.
;  When any program exits (JP 0000h or Ctrl+C):
;    1. h_wboot flushes any dirty Drive A: host buffer via BIOS HOME,
;    2. triggers a single 5632-byte REU FETCH from Bank 0:$0000 to CCP_BASE,
;    3. restores page-0 vectors (0000h JP WBOOT, 0005h JP BDOS) and default
;       DMA ($0080),
;    4. validates current drive in (0004h) (falls back to A: if >= 2), and
;       jumps straight to CCP_BASE with C = current drive!
;  Warm boot takes ~5.6 milliseconds (0 floppy seeks) and works even when B:
;  is the active logged-in drive!
; =============================================================================

        INCLUDE "reushared.inc"

        PUBLIC  r_sig, r_table, r_end, h_seldsk, call65, dph_b, dpb_b
        PUBLIC  wbootv, bdosv, ccp65, ccpz80

        ORG     RES_BASE

; -----------------------------------------------------------------------------
;  $FE00: Z80 resident code (<= 512 bytes, fits in $FE00-$FFFF)
; -----------------------------------------------------------------------------
r_sig:  DEFB    "REUDISK3"      ; installation signature (checked by installer)

; Hook table used by the installer:  BIOS entry number, hook, pass-through JP
r_table:
        DEFB    1               ; WBOOT
        DEFW    h_wboot, o_wboot
        DEFB    8               ; HOME
        DEFW    h_home, o_home
        DEFB    9               ; SELDSK
        DEFW    h_seldsk, o_seldsk
        DEFB    10              ; SETTRK
        DEFW    h_settrk, o_settrk
        DEFB    11              ; SETSEC
        DEFW    h_setsec, o_setsec
        DEFB    12              ; SETDMA
        DEFW    h_setdma, o_setdma
        DEFB    13              ; READ
        DEFW    h_read, o_read
        DEFB    14              ; WRITE
        DEFW    h_write, o_write
        DEFB    0FFh            ; end of table

; --- driver state & warm-boot parameters (filled by installer) ---------------
curdrv: DEFB    0               ; drive last passed to SELDSK (0=A:, 1=B:)
btrk:   DEFW    0               ; drive B: track   (0..31)
bsec:   DEFB    0               ; drive B: sector  (0..127, physical = logical)
bdma:   DEFW    0080h           ; current CP/M DMA address (Z80 view)
wbootv: DEFW    0               ; BIOS_BASE + 3 (for 0001h)
bdosv:  DEFW    0               ; BDOS entry    (for 0006h)
ccp65:  DEFW    0               ; 6510 address of CCP (Z80 CCP + $1000)

; -----------------------------------------------------------------------------
;  WBOOT: Instant REU-backed warm boot (~5.6 ms via DMA from REU Bank 0:$0000)
; -----------------------------------------------------------------------------
h_wboot:
        ld      sp,0080h
        call    o_home          ; flush Drive A: host buffer if dirty (HSTWRT)
        xor     a
        ld      (curdrv),a
        ld      (PB_REU),a      ; REU $0000
        ld      (PB_REU+1),a
        ld      (PB_BANK),a     ; REU Bank 0 (Track 0 system cache)
        ld      (PB_IMASK),a
        ld      (PB_ACR),a
        ld      (PB_STATUS),a
        ld      hl,(ccp65)      ; 6510 destination = CCP_BASE + $1000
        ld      (PB_C64),hl
        ld      hl,WB_LEN       ; 5632 bytes (CCP + BDOS)
        ld      (PB_LEN),hl
        ld      a,REU_FETCH
        ld      (PB_CMD),a
        call    call65          ; DMA reload CCP + BDOS in 5632 cycles!
        ld      a,(PB_STATUS)
        and     REU_EOB
        jr      z,o_wboot       ; fallback to floppy WBOOT if REU error

        ld      a,0C3h          ; restore Page 0 vectors
        ld      (0000h),a
        ld      hl,(wbootv)
        ld      (0001h),hl
        ld      (0005h),a
        ld      hl,(bdosv)
        ld      (0006h),hl

        ld      bc,0080h        ; default DMA = $0080
        call    h_setdma

        ld      a,(0004h)       ; current drive (low nibble) / user (high nibble)
        and     0Fh
        cp      2               ; only drives A: (0) and B: (1) exist
        ld      a,(0004h)
        jr      c,wb_ok
        and     0F0h            ; invalid drive -> reset to A: (keep user#)
        ld      (0004h),a
wb_ok:  ld      c,a
ccpz80  EQU     $+1
        jp      0               ; jump to CCP_BASE (patched by installer)
o_wboot:
        jp      0               ; -> original floppy WBOOT (patched by installer)

; -----------------------------------------------------------------------------
;  HOME
; -----------------------------------------------------------------------------
h_home:
        ld      a,(curdrv)
        dec     a
        jr      nz,o_home       ; not B: -> stock HOME
        ld      h,a             ; A = 0 here
        ld      l,a
        ld      (btrk),hl       ; B: track 0
        ret
o_home:
        jp      0

; -----------------------------------------------------------------------------
;  SELDSK  C = drive (0=A:), E bit0 = "already logged in" (ignored for B:)
;  Returns HL = DPH or 0000 if the drive does not exist.
; -----------------------------------------------------------------------------
h_seldsk:
        ld      a,c
        ld      (curdrv),a
        dec     a
        jr      nz,o_seldsk     ; A:, C:..P: -> stock SELDSK (A: DPH / error)
        ld      hl,dph_b        ; B: -> our private DPH, nothing shared with A:
        ret
o_seldsk:
        jp      0

; -----------------------------------------------------------------------------
;  SETTRK  BC = track.  Remembered for B:, forwarded only when B: is not
;  selected so the stock deblocker's "sektrk" is never polluted by B: values.
; -----------------------------------------------------------------------------
h_settrk:
        ld      (btrk),bc
        ld      a,(curdrv)
        dec     a
        ret     z
o_settrk:
        jp      0

; -----------------------------------------------------------------------------
;  SETSEC  BC = (translated) sector
; -----------------------------------------------------------------------------
h_setsec:
        ld      a,c
        ld      (bsec),a
        ld      a,(curdrv)
        dec     a
        ret     z
o_setsec:
        jp      0

; -----------------------------------------------------------------------------
;  SETDMA  BC = DMA address.  The DMA address is global in CP/M, so it is
;  always passed on to the stock BIOS as well.
; -----------------------------------------------------------------------------
h_setdma:
        ld      (bdma),bc
o_setdma:
        jp      0

; -----------------------------------------------------------------------------
;  READ / WRITE   Out: A = 0 ok, 1 = error.  WRITE's C (deferred/dir/unalloc)
;  is irrelevant: the REU is 128-byte addressable, no deblocking needed.
; -----------------------------------------------------------------------------
h_read:
        ld      a,(curdrv)
        dec     a
        jr      nz,o_read
        ld      a,REU_FETCH     ; REU -> C64 memory
        jr      xfer
o_read:
        jp      0

h_write:
        ld      a,(curdrv)
        dec     a
        jr      nz,o_write
        ld      a,REU_STASH     ; C64 memory -> REU
        jr      xfer
o_write:
        jp      0

; -----------------------------------------------------------------------------
;  xfer - marshal (track, sector, DMA) into the 6510 parameter block and run
;  one 128-byte REU transfer.     In: A = REU command ($90 stash / $91 fetch)
;
;  Linear record number  LBA = track * 128 + sector       (0..4095)
;  REU byte address      LBA * 128 = track << 14 | sector << 7   (19 bits)
;       bank ($DF06) = track >> 2
;       high ($DF05) = (track & 3) << 6 | sector >> 1
;       low  ($DF04) = (sector & 1) << 7
;  C64 address ($DF02/03) = Z80 DMA address + $1000 (cartridge address offset;
;  wraps mod 64K exactly like the Z80 view does: Z80 $F000 = 6510 $0000).
; -----------------------------------------------------------------------------
xfer:
        ld      (PB_CMD),a
        ld      hl,(btrk)
        ld      a,h
        or      a
        jr      nz,xerr         ; track > 255
        ld      a,l
        cp      B_TRACKS
        jr      nc,xerr         ; track >= 32
        ld      e,a             ; E = track
        ld      a,(bsec)
        cp      B_SPT
        jr      nc,xerr         ; sector >= 128
        ld      d,a             ; D = sector

        rrca                    ; sector bit 0 -> bit 7
        and     80h
        ld      (PB_REU),a      ; REU address bits 0-7
        ld      a,d
        srl     a               ; sector >> 1 (0..63)
        ld      d,a
        ld      a,e
        and     3
        rrca
        rrca                    ; (track & 3) << 6
        or      d
        ld      (PB_REU+1),a    ; REU address bits 8-15
        ld      a,e
        srl     a
        srl     a
        ld      (PB_BANK),a     ; REU address bits 16-18 (bank 0..7)

        ld      hl,(bdma)
        ld      de,Z2C
        add     hl,de           ; Z80 DMA address -> 6510 address
        ld      (PB_C64),hl
        ld      hl,128
        ld      (PB_LEN),hl     ; one CP/M record
        xor     a
        ld      (PB_IMASK),a
        ld      (PB_ACR),a      ; both addresses increment
        ld      (PB_STATUS),a
        call    call65          ; ---- 6510 performs the DMA ----
        ld      a,(PB_STATUS)
        and     REU_EOB         ; transfer completed?
        ld      a,0
        ret     nz              ; yes: A = 0 (flags from AND kept by LD)
xerr:   ld      a,1             ; BDOS will report "Bad Sector"
        ret

; -----------------------------------------------------------------------------
;  call65 - hand the bus to the 6510 and run ENTRY (BIOS65 command 9).
;  The Z80 is frozen by its write to $CE00 and resumes at the NOP once BIOS65
;  executes "LDA #0 / STA $DE00" after our 6510 routine returns.
; -----------------------------------------------------------------------------
call65:
        ld      hl,ENTRY65
        ld      (B65VEC),hl     ; 6510 $0906/$0907 = $0990
        ld      a,B65USER
        ld      (B65CMD),a      ; 6510 $0900 = 9 -> JMP ($0906)
        ld      a,1
        ld      (CPUSWITCH),a   ; Z80 off, 6510 on ...
        nop                     ; ... and back: execution continues here
        ret

; =============================================================================
;  Drive B: disk parameters - private to this driver, nothing shared with A:
; =============================================================================
;  Track 0 (16 KB) is reserved (OFF = 1) for the Instant Warm-Boot CCP+BDOS
;  cache in REU Bank 0 ($0000-$15FF).
;  Tracks 1..31 = 31 * 16 KB = 496 KB (248 x 2 KB blocks -> DSM = 247).
;  128 directory entries = 4 KB = 2 blocks -> AL0 = 11000000b.
;  Fixed (non-removable) medium -> CKS = 0.
dph_b:  DEFW    0               ; XLT: no sector translation
        DEFW    0, 0, 0         ; BDOS scratch
        DEFW    DIRBF_B_Z80     ; DIRBUF (private 128 bytes at $F970-$F9EF)
        DEFW    dpb_b           ; DPB
        DEFW    0               ; CSV (unused because CKS = 0)
        DEFW    ALV_B_Z80       ; ALV (private 32 bytes at $F950-$F96F)

dpb_b:  DEFW    B_SPT           ; SPT  records per track (128)
        DEFB    4               ; BSH  block shift  (2 KB)
        DEFB    15              ; BLM  block mask
        DEFB    1               ; EXM  extent mask
        DEFW    B_DSM           ; DSM  highest block number (247 -> 248 x 2 KB = 496 KB)
        DEFW    127             ; DRM  highest directory entry (128 entries)
        DEFB    0C0h, 00h       ; AL0, AL1: blocks 0,1 reserved for directory
        DEFW    0               ; CKS  no directory checksums
        DEFW    B_OFF           ; OFF  1 reserved track (Track 0 = WBOOT cache)

r_end:
        IF      r_end - RES_BASE > 512
        .ERROR  "resident block overflows Z80 $FFFF"
        ENDIF

        END
