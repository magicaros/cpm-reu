; =============================================================================
;  install.z80 - REUDISK.COM : installs the REU RAM-disk as drive B: and caches
;                CCP+BDOS in REU Track 0 for Instant Warm Boot (44K/48K/Soft80)
; =============================================================================
;
;  Assembler : pasmo 0.5.x  (pasmo -I src -I build install.z80 REUDISK.COM)
;
;  Usage (at the A> prompt):
;      REUDISK       install the driver, format B:, and cache CCP+BDOS in REU
;      REUDISK K     install the driver and cache CCP+BDOS, keeping B: files
;      REUDISK F     driver already resident: re-format B: and refresh cache
;
;  Steps
;   1. sanity checks: dynamically locate BIOS jump table via (0001h) - 3
;      (supports 44K at $AA00, 48K at $BA00, etc.) and verify BIOS65 command 9
;      ("JMP ($0906)") is present at 6510 $0A3C
;   2. copy the 64-byte 6510 trampoline + PB to Z80 $F980 (6510 $0980) and the
;      Z80 resident driver + DPH/DPB/ALV to Z80 $FE00 (6510 $0E00)
;   3. probe the REU through the trampoline: 1-byte stash/fetch round trips
;      to banks 0 and 4 (detects "no REU" and "REU smaller than 512 KB")
;   4. format (unless K): fill data tracks with $E5 using fixed-C64-address DMA
;   5. cache CCP+BDOS (5632 bytes from BIOS_BASE - $1600) into REU Track 0
;      (Bank 0, $0000-$15FF) with the CCP auto-boot command length cleared so
;      every subsequent warm boot completes in ~5.6 ms from REU DMA
;   6. patch the BIOS jump table (WBOOT, HOME, SELDSK, SETTRK, SETSEC, SETDMA,
;      READ, WRITE), saving each original target for pass-through
;   7. warm boot (JP 0) through our new instant REU WBOOT hook
; =============================================================================

        INCLUDE "reushared.inc"
        INCLUDE "reudrv.sym"    ; public labels of the resident block (pasmo)

BDOS    EQU     0005h
WBOOTV  EQU     0001h           ; address of the WBOOT jump-table entry
CMDTAIL EQU     0080h

        ORG     0100h

start:  ld      sp,stack
        ld      de,m_banner
        call    print

; --- 1. dynamically discover BIOS jump table from (0001h) - 3 -----------------
        ld      hl,(WBOOTV)
        ld      a,l
        cp      03h             ; WBOOT is always at BIOS_BASE + 3 ($xx03)
        jp      nz,e_bios
        dec     hl
        dec     hl
        dec     hl
        ld      (biosbase),hl   ; e.g. $AA00 (44K) or $BA00 (48K)
        ld      a,(hl)
        cp      0C3h            ; first entry (BOOT) must be a JP instruction
        jp      nz,e_bios

        ld      hl,B65CHK       ; 6510 $0A3C: JMP ($0906)
        ld      a,(hl)
        cp      6Ch
        jp      nz,e_bios
        inc     hl
        ld      a,(hl)
        cp      06h
        jp      nz,e_bios
        inc     hl
        ld      a,(hl)
        cp      09h
        jp      nz,e_bios

; --- parse option letter (CCP has already upper-cased the tail) --------------
        ld      hl,CMDTAIL
        ld      b,(hl)
        inc     b
optlp:  dec     b
        jr      z,optend
        inc     hl
        ld      a,(hl)
        cp      ' '
        jr      z,optlp
        ld      (opt),a
optend:

; --- already resident? -------------------------------------------------------
        call    isinst
        jr      nz,install
        ld      a,(opt)
        cp      'F'
        jp      nz,e_inst
        call    format
        call    savewb
        ld      de,m_fmt
        call    print
        jp      0

; --- 2. copy 6510 trampoline ($F910) and Z80 resident block ($FE00) ----------
install:
        ld      hl,trampimg
        ld      de,TRAMP_Z80
        ld      bc,trampimg_end-trampimg
        ldir

        ld      hl,resimg
        ld      de,RES_BASE
        ld      bc,resimg_end-resimg
        ldir

; --- 3. probe REU ------------------------------------------------------------
        call    reutest
        jp      nz,e_reu

; --- 4. format (unless K) and stash CCP+BDOS into REU Track 0 ----------------
        ld      a,(opt)
        cp      'K'
        jr      z,nofmt
        call    format
        ld      de,m_fmt
        call    print
nofmt:
        call    savewb          ; stash CCP+BDOS into REU Track 0 for instant WBOOT

; --- 5. hook the BIOS jump table ---------------------------------------------
        ld      ix,r_table
patchlp:
        ld      a,(ix+0)        ; BIOS entry number
        cp      0FFh
        jr      z,patched
        ld      l,a
        ld      h,0
        ld      e,l
        ld      d,h
        add     hl,hl
        add     hl,de           ; HL = 3 * n
        ld      de,(biosbase)
        inc     de              ; DE = BIOS_BASE + 1
        add     hl,de           ; HL -> operand of "JP xxxx" in jump table
        ld      e,(ix+3)
        ld      d,(ix+4)
        inc     de              ; DE -> operand of our pass-through "JP 0"
        ld      a,(hl)          ; copy original target ...
        ld      (de),a
        inc     hl
        inc     de
        ld      a,(hl)
        ld      (de),a
        ld      a,(ix+2)        ; ... and point the jump table at our hook
        ld      (hl),a
        dec     hl
        ld      a,(ix+1)
        ld      (hl),a
        ld      de,5
        add     ix,de
        jr      patchlp
patched:
        ld      de,m_ok
        call    print
        jp      0               ; warm boot through our instant REU WBOOT hook!

; =============================================================================
;  savewb - compute WBOOT/BDOS/CCP addresses and stash the 5.5 KB CCP+BDOS
;  image into REU Track 0 (Bank 0, $0000-$15FF) for instant warm boots.
; =============================================================================
savewb: ld      hl,(biosbase)
        ld      de,3
        add     hl,de
        ld      (wbootv),hl     ; BIOS_BASE + 3

        ld      hl,(biosbase)
        ld      de,0EA00h       ; -1600h = $EA00 (CCP = BIOS_BASE - $1600)
        add     hl,de           ; HL = CCP_BASE ($9400 on 44K, $A400 on 48K)
        ld      (ccpz80),hl

        push    hl
        ld      de,0806h
        add     hl,de           ; HL = BDOS_BASE ($9C06 on 44K, $AC06 on 48K)
        ld      (bdosv),hl
        pop     hl              ; HL = CCP_BASE

        ld      de,7
        add     hl,de
        ld      (hl),0          ; clear CCP initial command buffer length (CCP+7)
        ld      hl,(ccpz80)
        ld      de,Z2C
        add     hl,de           ; HL = 6510 address of CCP ($A400 or $B400)
        ld      (ccp65),hl
        ld      (PB_C64),hl

        xor     a
        ld      (PB_REU),a      ; REU $0000
        ld      (PB_REU+1),a
        ld      (PB_BANK),a     ; REU Bank 0
        ld      (PB_IMASK),a
        ld      (PB_ACR),a
        ld      (PB_STATUS),a
        ld      hl,WB_LEN       ; $1600 bytes (5632 bytes = CCP + BDOS)
        ld      (PB_LEN),hl
        ld      a,REU_STASH
        ld      (PB_CMD),a
        jp      call65

; =============================================================================
;  isinst - Z set if the driver is already resident and hooked
; =============================================================================
isinst: ld      hl,r_sig        ; resident signature (if present)
        ld      de,resimg+(r_sig-RES_BASE)  ; reference copy in this .COM
        ld      b,8
islp:   ld      a,(de)
        cp      (hl)
        ret     nz
        inc     hl
        inc     de
        djnz    islp
        ld      hl,(biosbase)
        ld      de,9*3+1        ; SELDSK target offset
        add     hl,de
        ld      a,(hl)
        inc     hl
        ld      h,(hl)
        ld      l,a
        ld      de,h_seldsk
        or      a
        sbc     hl,de
        ret

; =============================================================================
;  reu1 - one-byte transfer between 'tbyte' and REU bank B, address $0000
;  In: A = REU command, B = bank
; =============================================================================
reu1:   ld      (PB_CMD),a
        ld      a,b
        ld      (PB_BANK),a
        ld      hl,tbyte+Z2C
        ld      (PB_C64),hl
        ld      hl,0
        ld      (PB_REU),hl
        inc     hl
        ld      (PB_LEN),hl
        xor     a
        ld      (PB_IMASK),a
        ld      (PB_ACR),a
        ld      (PB_STATUS),a
        jp      call65

; =============================================================================
;  reutest - Z set if a >= 512 KB REU answers.  NZ: A=1 no REU, A=2 too small.
;  (destructive for two bytes; only used before formatting/installing)
; =============================================================================
reutest:
        ld      a,(PB_MAGIC)
        cp      65h
        jr      nz,noreu        ; trampoline not where we expect it
        ld      a,0A5h
        ld      (tbyte),a
        ld      a,REU_STASH
        ld      b,0
        call    reu1            ; bank 0 := $A5
        ld      a,05Ah
        ld      (tbyte),a
        ld      a,REU_STASH
        ld      b,4
        call    reu1            ; bank 4 := $5A (aliases bank 0 if <= 256 KB)
        xor     a
        ld      (tbyte),a
        ld      a,REU_FETCH
        ld      b,0
        call    reu1
        ld      a,(tbyte)
        cp      05Ah
        jr      z,small         ; bank 4 overwrote bank 0
        cp      0A5h
        jr      nz,noreu
        xor     a
        ld      (tbyte),a
        ld      a,REU_FETCH
        ld      b,4
        call    reu1
        ld      a,(tbyte)
        cp      05Ah
        jr      nz,noreu
        xor     a               ; Z: ok
        ret
small:  ld      a,2
        or      a
        ret
noreu:  ld      a,1
        or      a
        ret

; =============================================================================
;  format - fill REU banks 0-7 with $E5 (empty CP/M directory and data)
;  Uses ACR bit 7 (fixed C64 address): the REU reads the same $E5 byte 32768
;  times per transfer, 16 transfers = 512 KB, about half a second.
; =============================================================================
format: ld      a,0E5h
        ld      (tbyte),a
        ld      hl,tbyte+Z2C
        ld      (PB_C64),hl
        ld      hl,0
        ld      (PB_REU),hl
        ld      hl,8000h
        ld      (PB_LEN),hl
        xor     a
        ld      (PB_BANK),a
        ld      (PB_IMASK),a
        ld      a,ACR_FIXC64
        ld      (PB_ACR),a
        ld      b,16
fmtlp:  push    bc
        ld      a,REU_STASH
        ld      (PB_CMD),a
        call    call65
        pop     bc
        ld      a,(PB_REU+1)    ; next 32 KB: $0000 -> $8000 -> next bank
        xor     80h
        ld      (PB_REU+1),a
        jr      nz,fmtnx
        ld      hl,PB_BANK
        inc     (hl)
fmtnx:  djnz    fmtlp
        xor     a
        ld      (PB_ACR),a      ; back to normal addressing
        ret

; =============================================================================
print:  ld      c,9
        jp      BDOS

e_bios: ld      de,m_bios
        jr      fail
e_inst: ld      de,m_inst
        jr      fail
e_reu:  cp      2
        ld      de,m_small
        jr      z,fail
        ld      de,m_noreu
fail:   call    print
        jp      0

m_banner:
        DEFB    13,10,"REUDISK 1.2 - 512K REU RAM disk + Instant WBOOT",13,10,"$"
m_ok:   DEFB    "Drive B: + Instant REU Warm Boot installed.",13,10,"$"
m_fmt:  DEFB    "B: formatted (496K data + 16K WBOOT cache).",13,10,"$"
m_bios: DEFB    "Incompatible C64 CP/M BIOS - aborted.",13,10,"$"
m_inst: DEFB    "Already installed (REUDISK F re-formats B:).",13,10,"$"
m_noreu:
        DEFB    "No REU found (enable a 512K REU) - aborted.",13,10,"$"
m_small:
        DEFB    "REU is smaller than 512K - aborted.",13,10,"$"

biosbase:
        DEFW    0
opt:    DEFB    0
tbyte:  DEFB    0

; --- 6510 trampoline image, copied to TRAMP_Z80 ($F980 = 6510 $0980) ---------
trampimg:
        INCBIN  "reu6510.bin"
trampimg_end:

; --- Z80 resident image, copied to RES_BASE ($FE00 = 6510 $0E00) -------------
resimg:
        INCBIN  "reudrv.bin"
resimg_end:

        DEFS    64
stack:

        END
