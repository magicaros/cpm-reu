000000r 1               ; =============================================================================
000000r 1               ;  reu6510.s  -  6510 side of the C64 CP/M 2.2 REU RAM-disk (drive B:)
000000r 1               ; =============================================================================
000000r 1               ;
000000r 1               ;  Assembler : ca65 (cc65 suite)          ld65 config: src/reu6510.cfg
000000r 1               ;  Load addr : 6510 $C000  (= Z80 $B000 because Z80 addr = 6510 addr - $1000)
000000r 1               ;
000000r 1               ;  HOW THE 6510 GETS HERE
000000r 1               ;  ----------------------
000000r 1               ;  The Commodore CP/M cartridge alternates the two CPUs through IO1 ($DE00):
000000r 1               ;
000000r 1               ;    6510 BIOS65 main loop (resident at 6510 $0A00, unchanged by us):
000000r 1               ;
000000r 1               ;        $0A00  LDA #$00
000000r 1               ;        $0A02  STA $DE00      ; hand the bus to the Z80, 6510 freezes HERE
000000r 1               ;        $0A05  NOP            ; <- resumes here when the Z80 writes 1 to $CE00
000000r 1               ;        $0A06  JSR $0A0C      ; dispatch on command byte at $0900
000000r 1               ;        $0A09  JMP $0A00      ; ...and give the bus back to the Z80
000000r 1               ;
000000r 1               ;    The dispatcher at $0A0C jumps through a table at $0A28; command 9 is the
000000r 1               ;    "user" command:   $0A3C  JMP ($0906)
000000r 1               ;
000000r 1               ;  The Z80 driver therefore:
000000r 1               ;      1. fills the parameter block below (6510 $C000 = Z80 $B000),
000000r 1               ;      2. stores ENTRY's address in the user vector $0906/$0907 (Z80 $F906),
000000r 1               ;      3. stores 9 in the command byte $0900 (Z80 $F900),
000000r 1               ;      4. writes 1 to Z80 $CE00 (= 6510 $DE00): the Z80 stops, the 6510 wakes
000000r 1               ;         up after its STA $DE00, dispatches command 9 and lands in ENTRY.
000000r 1               ;  ENTRY performs the REU DMA and simply RTSes; BIOS65 then executes its own
000000r 1               ;  "LDA #0 / STA $DE00" which restarts the Z80 right after its $CE00 write.
000000r 1               ;  Re-using BIOS65's handshake (instead of doing our own STA $DE00 here) keeps
000000r 1               ;  the 6510's "resume point" inside BIOS65, so console/disk commands issued
000000r 1               ;  later by the stock Z80 BIOS keep working.
000000r 1               ;
000000r 1               ;  Memory: 6510 $C000-$CFFF is not used by CP/M, BIOS65, the KERNAL or the VIC
000000r 1               ;  (VIC bank 0, screen at $0400) - it is the classic free 4K block.
000000r 1               ; =============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1               
000000r 1               ; --- Commodore 1700/1750/1764 REU registers (IO2) ----------------------------
000000r 1               REU_STATUS  = $DF00     ; R : b7 IRQ, b6 end-of-block, b5 verify err, b4 256K chips
000000r 1               REU_CMD     = $DF01     ; W : b7 execute, b5 autoload, b4 1=no $FF00 trigger,
000000r 1                                       ;     b1-0: 00 C64->REU (stash) 01 REU->C64 (fetch)
000000r 1               REU_C64LO   = $DF02     ; C64 base address
000000r 1               REU_C64HI   = $DF03
000000r 1               REU_REULO   = $DF04     ; REU base address (bits 0-15)
000000r 1               REU_REUHI   = $DF05
000000r 1               REU_BANK    = $DF06     ; REU bank (bits 16-23, 0-7 for a 512 KB 1750)
000000r 1               REU_LENLO   = $DF07     ; transfer length ($0000 = 64 KB)
000000r 1               REU_LENHI   = $DF08
000000r 1               REU_IMASK   = $DF09     ; interrupt mask
000000r 1               REU_ACR     = $DF0A     ; address control: b7 fix C64 addr, b6 fix REU addr
000000r 1               
000000r 1                       .segment "CODE"
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;  Shared parameter block - 6510 $C000..$C00F  /  Z80 $B000..$B00F
000000r 1               ;  Bytes +1..+10 are laid out exactly like REU registers $DF01..$DF0A so the
000000r 1               ;  copy loop below is a straight indexed move.  Filled by the Z80 driver.
000000r 1               ; =============================================================================
000000r 1               PB:
000000r 1  65           PB_MAGIC:   .byte $65           ; +0  marker (lets the installer sanity-check)
000001r 1  00           PB_CMD:     .byte $00           ; +1  -> $DF01 ($90 = stash, $91 = fetch)
000002r 1  00 00        PB_C64:     .word $0000         ; +2  -> $DF02/03  6510 address (Z80 DMA+$1000)
000004r 1  00 00        PB_REU:     .word $0000         ; +4  -> $DF04/05  REU address
000006r 1  00           PB_BANK:    .byte $00           ; +6  -> $DF06     REU bank
000007r 1  80 00        PB_LEN:     .word $0080         ; +7  -> $DF07/08  length (128 = one CP/M record)
000009r 1  00           PB_IMASK:   .byte $00           ; +9  -> $DF09     no REU interrupts
00000Ar 1  00           PB_ACR:     .byte $00           ; +10 -> $DF0A     0 = both addresses increment
00000Br 1  00           PB_STATUS:  .byte $00           ; +11 <- $DF00 after the transfer
00000Cr 1  00 00 00 00              .res  4, $00        ; +12..+15 reserved
000010r 1               
000010r 1               ; =============================================================================
000010r 1               ;  ENTRY - 6510 $C010.  Reached by JSR $0A0C -> JMP ($0A3A) -> JMP ($0906).
000010r 1               ;  In : parameter block above.     Out: PB_STATUS = REU status register.
000010r 1               ;  Preserves the caller's interrupt flag; A/X/Y are not needed by BIOS65.
000010r 1               ; =============================================================================
000010r 1               ENTRY:
000010r 1  08                   php                     ; remember the I flag BIOS65 runs with (CLI'd:
000011r 1  78                   sei                     ; KERNAL keyboard IRQ) and block IRQs so no
000012r 1                                               ; IRQ handler can touch the REU/IO mid-setup
000012r 1  D8                   cld
000013r 1               
000013r 1  A2 09                ldx     #9              ; copy PB+2..PB+10 -> $DF02..$DF0A (X = 9..1)
000015r 1  BD rr rr     @copy:  lda     PB_CMD,x
000018r 1  9D 01 DF             sta     REU_CMD,x
00001Br 1  CA                   dex
00001Cr 1  D0 F7                bne     @copy
00001Er 1               
00001Er 1  AD 00 DF             lda     REU_STATUS      ; reading $DF00 clears stale EOB/IRQ bits
000021r 1               
000021r 1  AD rr rr             lda     PB_CMD          ; bit7=execute, bit4=start now (no $FF00 wait)
000024r 1  8D 01 DF             sta     REU_CMD         ; the REU asserts DMA and freezes the 6510
000027r 1                                               ; until all bytes are moved (1 byte/cycle)
000027r 1               
000027r 1  AD 00 DF             lda     REU_STATUS      ; b6 = end of block -> Z80 checks it
00002Ar 1  8D rr rr             sta     PB_STATUS       ; (read also acknowledges the status)
00002Dr 1               
00002Dr 1  28                   plp                     ; restore the caller's interrupt state
00002Er 1  60                   rts                     ; back to BIOS65 -> LDA #0 / STA $DE00 -> Z80
00002Fr 1               ENTRY_END:
00002Fr 1               
00002Fr 1                       .assert ENTRY = PB + 16, error, "ENTRY must sit at $C010"
00002Fr 1                       .assert ENTRY_END <= $C100, lderror, "6510 module must fit in one page"
00002Fr 1                       ; ld65 pads the output to exactly one page (Z80 $B000-$B0FF).
00002Fr 1               
