000000r 1               ; =============================================================================
000000r 1               ;  reu6510.s  -  6510 side of the C64 CP/M 2.2 REU RAM-disk (drive B:)
000000r 1               ; =============================================================================
000000r 1               ;
000000r 1               ;  Assembler : ca65 (cc65 suite)          ld65 config: src/reu6510.cfg
000000r 1               ;  Load addr : 6510 $0980  (= Z80 $F980 because Z80 addr = 6510 addr - $1000)
000000r 1               ;
000000r 1               ;  UNIVERSAL PLACEMENT (44K, 48K, AND SOFT80 COMPATIBLE)
000000r 1               ;  -----------------------------------------------------
000000r 1               ;  Page $0900-$09FF (Z80 $F900-$F9FF) is the BIOS65 communication page:
000000r 1               ;      $0900-$0907  Command/data/sector/track/drive/key/indirect vector
000000r 1               ;      $0908-$09FE  Completely unused by BIOS65, CP/M 44K/48K, and SOFT80.COM
000000r 1               ;      $09FF        Printer status byte
000000r 1               ;  Placing the 16-byte parameter block at $0980-$098F and the 6510 REU DMA
000000r 1               ;  trampoline at $0990-$09BF avoids touching $C000-$CFFF (which holds the
000000r 1               ;  48K BDOS/BIOS on 48K CP/M disks) and avoids $0400-$05FF / $D000-$FFFF
000000r 1               ;  (which are used by SOFT80.COM).
000000r 1               ;
000000r 1               ;  HOW THE 6510 GETS HERE
000000r 1               ;  ----------------------
000000r 1               ;  The Commodore CP/M cartridge alternates the two CPUs through IO1 ($DE00):
000000r 1               ;
000000r 1               ;    6510 BIOS65 main loop (resident at 6510 $0A00, unchanged by us):
000000r 1               ;
000000r 1               ;        $0A00  LDA #$00
000000r 1               ;        $0A02  STA $DE00      ; hand the bus to the Z80, 6510 freezes HERE
000000r 1               ;        $0A05  NOP            ; <- resumes here when the Z80 writes 1 to $CE00
000000r 1               ;        $0A06  JSR $0A0C      ; dispatch on command byte at $0900
000000r 1               ;        $0A09  JMP $0A00      ; ...and give the bus back to the Z80
000000r 1               ;
000000r 1               ;    The dispatcher at $0A0C jumps through a table at $0A28; command 9 is the
000000r 1               ;    "user" command:   $0A3C  JMP ($0906)
000000r 1               ; =============================================================================
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1               
000000r 1               ; --- Commodore 1700/1750/1764 REU registers (IO2) ----------------------------
000000r 1               REU_STATUS  = $DF00     ; R : b7 IRQ, b6 end-of-block, b5 verify err, b4 256K chips
000000r 1               REU_CMD     = $DF01     ; W : b7 execute, b5 autoload, b4 1=no $FF00 trigger,
000000r 1                                       ;     b1-0: 00 C64->REU (stash) 01 REU->C64 (fetch)
000000r 1               REU_C64LO   = $DF02     ; C64 base address
000000r 1               REU_C64HI   = $DF03
000000r 1               REU_REULO   = $DF04     ; REU base address (bits 0-15)
000000r 1               REU_REUHI   = $DF05
000000r 1               REU_BANK    = $DF06     ; REU bank (bits 16-23, 0-7 for a 512 KB 1750)
000000r 1               REU_LENLO   = $DF07     ; transfer length ($0000 = 64 KB)
000000r 1               REU_LENHI   = $DF08
000000r 1               REU_IMASK   = $DF09     ; interrupt mask
000000r 1               REU_ACR     = $DF0A     ; address control: b7 fix C64 addr, b6 fix REU addr
000000r 1               
000000r 1                       .segment "CODE"
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;  Shared parameter block - 6510 $0980..$098F  /  Z80 $F980..$F98F
000000r 1               ;  Bytes +1..+10 are laid out exactly like REU registers $DF01..$DF0A so the
000000r 1               ;  copy loop below is a straight indexed move.  Filled by the Z80 driver.
000000r 1               ; =============================================================================
000000r 1               PB:
000000r 1  65           PB_MAGIC:   .byte $65           ; +0  marker (lets the installer sanity-check)
000001r 1  00           PB_CMD:     .byte $00           ; +1  -> $DF01 ($90 = stash, $91 = fetch)
000002r 1  00 00        PB_C64:     .word $0000         ; +2  -> $DF02/03  6510 address (Z80 DMA+$1000)
000004r 1  00 00        PB_REU:     .word $0000         ; +4  -> $DF04/05  REU address
000006r 1  00           PB_BANK:    .byte $00           ; +6  -> $DF06     REU bank
000007r 1  80 00        PB_LEN:     .word $0080         ; +7  -> $DF07/08  length (128 = one CP/M record)
000009r 1  00           PB_IMASK:   .byte $00           ; +9  -> $DF09     no REU interrupts
00000Ar 1  00           PB_ACR:     .byte $00           ; +10 -> $DF0A     0 = both addresses increment
00000Br 1  00           PB_STATUS:  .byte $00           ; +11 <- $DF00 after the transfer
00000Cr 1  00 00 00 00              .res  4, $00        ; +12..+15 reserved
000010r 1               
000010r 1               ; =============================================================================
000010r 1               ;  ENTRY - 6510 $0990.  Reached by JSR $0A0C -> JMP ($0A3A) -> JMP ($0906).
000010r 1               ;  In : parameter block above.     Out: PB_STATUS = REU status register.
000010r 1               ;  Preserves the caller's interrupt flag and 6510 $01 memory banking.
000010r 1               ; =============================================================================
000010r 1               ENTRY:
000010r 1  08                   php                     ; remember the I flag BIOS65 runs with
000011r 1  78                   sei                     ; block IRQs during REU register setup & DMA
000012r 1  D8                   cld
000013r 1               
000013r 1  A5 01                lda     $01             ; save 6510 processor port
000015r 1  48                   pha
000016r 1  A9 35                lda     #$35            ; bank out BASIC ($A000-$BFFF) and KERNAL
000018r 1  85 01                sta     $01             ; ($E000-$FFFF) -> ALL RAM visible to REU DMA
00001Ar 1                                               ; except I/O ($D000-$DFFF -> REU at $DF00)!
00001Ar 1               
00001Ar 1  A2 09                ldx     #9              ; copy PB+2..PB+10 -> $DF02..$DF0A (X = 9..1)
00001Cr 1  BD rr rr     @copy:  lda     PB_CMD,x
00001Fr 1  9D 01 DF             sta     REU_CMD,x
000022r 1  CA                   dex
000023r 1  D0 F7                bne     @copy
000025r 1               
000025r 1  AD 00 DF             lda     REU_STATUS      ; reading $DF00 clears stale EOB/IRQ bits
000028r 1               
000028r 1  AD rr rr             lda     PB_CMD          ; bit7=execute, bit4=start now (no $FF00 wait)
00002Br 1  8D 01 DF             sta     REU_CMD         ; the REU asserts DMA and freezes the 6510
00002Er 1                                               ; until all bytes are moved (1 byte/cycle)
00002Er 1               
00002Er 1  AD 00 DF             lda     REU_STATUS      ; b6 = end of block -> Z80 checks it
000031r 1  8D rr rr             sta     PB_STATUS       ; (read also acknowledges the status)
000034r 1               
000034r 1  68                   pla                     ; restore 6510 processor port ($01 = $36)
000035r 1  85 01                sta     $01
000037r 1  28                   plp                     ; restore the caller's interrupt state
000038r 1  60                   rts                     ; back to BIOS65 -> LDA #0 / STA $DE00 -> Z80
000039r 1               ENTRY_END:
000039r 1               
000039r 1                       .assert ENTRY = PB + 16, error, "ENTRY must sit at $0920"
000039r 1                       .assert ENTRY_END <= $0950, lderror, "6510 module must fit in 64 bytes"
000039r 1               
